---
import { getEmDashEntry, decodeSlug } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: cls, cacheHint } = await getEmDashEntry("classes", slug);

if (!cls) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const start = new Date(String(cls.data.start_time));
const end = cls.data.end_time ? new Date(String(cls.data.end_time)) : null;
const isPast = start.getTime() < Date.now();

const dateLine = start.toLocaleDateString("en-US", {
	weekday: "long",
	month: "long",
	day: "numeric",
	year: "numeric",
});
const timeOpts = { hour: "numeric", minute: "2-digit" } as const;
const timeLine =
	start.toLocaleTimeString("en-US", timeOpts) +
	(end ? `–${end.toLocaleTimeString("en-US", timeOpts)}` : "");

// The plugin API needs the database ULID, not the slug
const classId = cls.data.id;

function getImageSrc(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	return typeof image.src === "string" ? image.src : undefined;
}
---

<Base
	title={cls.data.title}
	description={cls.data.summary}
	image={getImageSrc(cls.data.featured_image)}
>
	<article class="class-page">
		<header class="class-header">
			<p class="class-meta">
				<span {...cls.edit.start_time}>{dateLine}</span>
				<span class="meta-separator">·</span>
				<span>{timeLine}</span>
				{
					cls.data.price && (
						<>
							<span class="meta-separator">·</span>
							<span {...cls.edit.price}>{cls.data.price}</span>
						</>
					)
				}
			</p>
			<h1 class="class-title" {...cls.edit.title}>{cls.data.title}</h1>
			{
				cls.data.summary && (
					<p class="class-summary" {...cls.edit.summary}>
						{cls.data.summary}
					</p>
				)
			}
			{
				cls.data.location && (
					<p class="class-location" {...cls.edit.location}>
						{cls.data.location}
					</p>
				)
			}
		</header>

		{
			cls.data.featured_image && (
				<div class="featured-image" {...cls.edit.featured_image}>
					<Image image={cls.data.featured_image} />
				</div>
			)
		}

		{
			cls.data.content && (
				<div class="class-content">
					<PortableText value={cls.data.content} />
				</div>
			)
		}

		<section class="signup" id="signup">
			<h2 class="signup-title">{isPast ? "This class has ended" : "Sign up"}</h2>

			{
				isPast ? (
					<p class="signup-closed-note">
						This session is over. <a href="/classes">See upcoming classes</a> or{" "}
						<a href="/contact">get in touch</a> to hear about the next one.
					</p>
				) : (
					<>
						<p class="spots-line" data-spots data-capacity={cls.data.capacity}>
							Limited to {cls.data.capacity} people.
						</p>

						<form class="signup-form" data-signup-form data-class-id={classId}>
							<div class="form-error" data-form-error hidden></div>

							<div class="form-field">
								<label for="signup-name">Name</label>
								<input
									type="text"
									id="signup-name"
									name="name"
									required
									maxlength="200"
									placeholder="Your name"
									autocomplete="name"
								/>
							</div>

							<div class="form-field">
								<label for="signup-email">Email</label>
								<input
									type="email"
									id="signup-email"
									name="email"
									required
									placeholder="you@example.com"
									autocomplete="email"
								/>
							</div>

							<div class="form-field">
								<label for="signup-notes">Anything we should know? <span class="optional">(optional)</span></label>
								<textarea
									id="signup-notes"
									name="notes"
									rows="3"
									maxlength="1000"
									placeholder="Experience level, accessibility needs…"
								></textarea>
							</div>

							<button type="submit" class="form-submit" data-submit>
								Reserve a spot
							</button>
						</form>

						<div class="form-success" data-form-success hidden>
							<h3>You're in</h3>
							<p data-success-message>
								Your spot is reserved. We'll email you the details before the
								session.
							</p>
						</div>
					</>
				)
			}
		</section>
	</article>
</Base>

<script>
	const form = document.querySelector<HTMLFormElement>("[data-signup-form]");

	if (form) {
		const classId = form.dataset.classId!;
		const api = "/_emdash/api/plugins/class-signups";
		const errorBox = document.querySelector<HTMLElement>("[data-form-error]")!;
		const successBox = document.querySelector<HTMLElement>("[data-form-success]")!;
		const successMessage = document.querySelector<HTMLElement>("[data-success-message]")!;
		const spotsLine = document.querySelector<HTMLElement>("[data-spots]")!;
		const submitButton = form.querySelector<HTMLButtonElement>("[data-submit]")!;

		// Plugin routes wrap their return value in a { success, data } envelope
		const unwrap = (payload: unknown): any => {
			if (payload && typeof payload === "object" && "data" in payload) {
				return (payload as { data: unknown }).data;
			}
			return payload;
		};

		const markFull = () => {
			spotsLine.textContent = "This class is full.";
			submitButton.disabled = true;
			submitButton.textContent = "Class full";
		};

		const refreshSpots = async () => {
			try {
				const res = await fetch(`${api}/availability?classId=${encodeURIComponent(classId)}`);
				if (!res.ok) return;
				const data = unwrap(await res.json());
				if (!data || data.closed || data.error) return;
				if (data.full) {
					markFull();
				} else if (typeof data.remaining === "number") {
					const capacity = spotsLine.dataset.capacity;
					spotsLine.textContent =
						data.remaining === 1
							? `1 spot left of ${capacity}.`
							: `${data.remaining} spots left of ${capacity}.`;
				}
			} catch {
				// Leave the static capacity line in place
			}
		};

		refreshSpots();

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			errorBox.hidden = true;
			submitButton.disabled = true;
			submitButton.textContent = "Reserving…";

			const formData = new FormData(form);
			try {
				const res = await fetch(`${api}/signup`, {
					method: "POST",
					// X-EmDash-Request satisfies the CSRF check even when the
					// configured public origin differs from the request origin
					headers: {
						"Content-Type": "application/json",
						"X-EmDash-Request": "1",
					},
					body: JSON.stringify({
						classId,
						name: formData.get("name"),
						email: formData.get("email"),
						notes: formData.get("notes") || undefined,
					}),
				});
				const data = unwrap(await res.json());

				if (res.ok && data?.success) {
					if (data.alreadyRegistered) {
						successMessage.textContent =
							"You're already signed up for this class — see you there.";
					}
					form.hidden = true;
					spotsLine.hidden = true;
					successBox.hidden = false;
				} else {
					errorBox.textContent =
						typeof data?.error === "string"
							? data.error
							: "Something went wrong. Please try again.";
					errorBox.hidden = false;
					submitButton.disabled = false;
					submitButton.textContent = "Reserve a spot";
					if (data?.full) markFull();
				}
			} catch {
				errorBox.textContent = "Something went wrong. Please try again.";
				errorBox.hidden = false;
				submitButton.disabled = false;
				submitButton.textContent = "Reserve a spot";
			}
		});
	}
</script>

<style>
	.class-page {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 var(--spacing-lg) var(--spacing-4xl);
	}

	.class-header {
		margin-bottom: var(--spacing-2xl);
	}

	.class-meta {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		margin-bottom: var(--spacing-sm);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
	}

	.meta-separator {
		margin: 0 var(--spacing-sm);
	}

	.class-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		line-height: var(--leading-tight);
		margin-bottom: var(--spacing-lg);
	}

	.class-summary {
		font-size: var(--font-size-lg);
		color: var(--color-muted);
		line-height: var(--leading-normal);
		margin-bottom: var(--spacing-md);
	}

	.class-location {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.featured-image {
		margin-bottom: var(--spacing-3xl);
	}

	.featured-image img {
		width: 100%;
		height: auto;
		border-radius: var(--radius);
	}

	.class-content {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		margin-bottom: var(--spacing-3xl);
	}

	.class-content :global(p) {
		margin-bottom: 1.5em;
	}

	.class-content :global(h2) {
		font-family: var(--font-heading);
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-heading);
		margin-top: 2.5em;
		margin-bottom: 0.75em;
	}

	.class-content :global(h3) {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		margin-top: 2em;
		margin-bottom: 0.5em;
	}

	.class-content :global(blockquote) {
		margin: 2em 0;
		padding-left: var(--spacing-xl);
		border-left: 2px solid var(--color-brand);
		color: var(--color-muted);
		font-family: var(--font-heading);
		font-style: italic;
		font-size: var(--font-size-lg);
	}

	.class-content :global(ul),
	.class-content :global(ol) {
		margin-bottom: 1.5em;
		padding-left: 1.25em;
	}

	.class-content :global(li) {
		margin-bottom: 0.5em;
	}

	.signup {
		padding-top: var(--spacing-2xl);
		border-top: 1px solid var(--color-border);
	}

	.signup-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-heading);
		margin-bottom: var(--spacing-sm);
	}

	.signup-closed-note {
		color: var(--color-muted);
	}

	.signup-closed-note a {
		color: var(--color-text);
	}

	.spots-line {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		margin-bottom: var(--spacing-xl);
	}

	.signup-form {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-lg);
	}

	.form-field {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
	}

	.form-field label {
		font-size: var(--font-size-sm);
		font-weight: 500;
	}

	.optional {
		color: var(--color-muted);
		font-weight: 400;
	}

	.form-field input,
	.form-field textarea {
		padding: var(--spacing-md);
		font-family: inherit;
		font-size: var(--font-size-base);
		color: var(--color-text);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		transition:
			border-color var(--transition-fast),
			box-shadow var(--transition-fast);
	}

	.form-field input:focus,
	.form-field textarea:focus {
		outline: none;
		border-color: var(--color-brand);
		box-shadow: 0 0 0 3px var(--color-brand-ring);
	}

	.form-field input::placeholder,
	.form-field textarea::placeholder {
		color: var(--color-muted);
	}

	.form-field textarea {
		resize: vertical;
	}

	.form-submit {
		align-self: flex-start;
		padding: var(--spacing-md) var(--spacing-xl);
		font-family: inherit;
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-bg);
		background: var(--color-text);
		border: none;
		border-radius: var(--radius);
		cursor: pointer;
		transition:
			background var(--transition-fast),
			transform var(--transition-fast);
	}

	.form-submit:hover:not(:disabled) {
		background: var(--color-brand);
		color: var(--color-on-brand);
		transform: translateY(-1px);
	}

	.form-submit:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}

	.form-error {
		padding: var(--spacing-md);
		background: color-mix(in srgb, var(--color-danger) 10%, transparent);
		border: 1px solid color-mix(in srgb, var(--color-danger) 30%, transparent);
		border-radius: var(--radius);
		color: var(--color-danger);
		font-size: var(--font-size-sm);
	}

	.form-success {
		padding: var(--spacing-2xl);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		text-align: center;
	}

	.form-success h3 {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		margin-bottom: var(--spacing-sm);
	}

	.form-success p {
		color: var(--color-muted);
	}

	@media (max-width: 768px) {
		.class-title {
			font-size: var(--font-size-3xl);
		}
	}
</style>
