---
export const prerender = false;

import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const { entries: classes, cacheHint } = await getEmDashCollection("classes", {
	orderBy: { start_time: "asc" },
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const now = Date.now();
const toDate = (value: unknown) => new Date(String(value));
const upcoming = classes.filter((c) => toDate(c.data.start_time).getTime() >= now);
const past = classes
	.filter((c) => toDate(c.data.start_time).getTime() < now)
	.reverse();

const formatDate = (value: unknown) =>
	toDate(value).toLocaleDateString("en-US", {
		weekday: "short",
		month: "long",
		day: "numeric",
		year: "numeric",
	});

const formatTime = (value: unknown) =>
	toDate(value).toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
---

<Base
	title="Classes"
	description="Small, hands-on classes and workshops at the studio."
>
	<section class="classes-header">
		<h1>Classes</h1>
		<p class="classes-intro">
			Small, hands-on sessions at the studio — photography, identity, and
			editorial craft. Every class is capped so there's time for real critique.
		</p>
	</section>

	{
		upcoming.length > 0 ? (
			<section class="classes-list">
				{upcoming.map((cls) => (
					<a href={`/classes/${cls.id}`} class="class-card">
						{cls.data.featured_image && (
							<div class="class-image">
								<Image image={cls.data.featured_image} />
							</div>
						)}
						<div class="class-body">
							<p class="class-meta">
								<span>{formatDate(cls.data.start_time)}</span>
								<span class="meta-separator">·</span>
								<span>{formatTime(cls.data.start_time)}</span>
								{cls.data.price && (
									<>
										<span class="meta-separator">·</span>
										<span>{cls.data.price}</span>
									</>
								)}
							</p>
							<h2 class="class-title">{cls.data.title}</h2>
							{cls.data.summary && <p class="class-summary">{cls.data.summary}</p>}
							{cls.data.location && (
								<p class="class-location">{cls.data.location}</p>
							)}
						</div>
					</a>
				))}
			</section>
		) : (
			<section class="empty-state">
				<p>No upcoming classes right now. Check back soon.</p>
			</section>
		)
	}

	{
		past.length > 0 && (
			<section class="past-classes">
				<h2 class="past-title">Past classes</h2>
				<ul class="past-list">
					{past.map((cls) => (
						<li>
							<a href={`/classes/${cls.id}`}>{cls.data.title}</a>
							<span class="past-date">{formatDate(cls.data.start_time)}</span>
						</li>
					))}
				</ul>
			</section>
		)
	}
</Base>

<style>
	.classes-header {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-3xl) var(--spacing-lg) var(--spacing-2xl);
	}

	.classes-header h1 {
		font-size: var(--font-size-3xl);
		margin-bottom: var(--spacing-md);
	}

	.classes-intro {
		font-size: var(--font-size-lg);
		color: var(--color-muted);
		max-width: 600px;
	}

	.classes-list {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--spacing-lg) var(--spacing-3xl);
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--spacing-2xl);
	}

	.class-card {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.class-image {
		margin-bottom: var(--spacing-md);
		overflow: hidden;
		border-radius: var(--radius);
	}

	.class-image :global(img) {
		width: 100%;
		height: auto;
		display: block;
		transition: transform var(--transition-slow, 0.4s ease);
	}

	.class-card:hover .class-image :global(img) {
		transform: scale(1.02);
	}

	.class-meta {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		margin-bottom: var(--spacing-xs);
	}

	.meta-separator {
		margin: 0 var(--spacing-xs);
	}

	.class-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-heading);
		line-height: var(--leading-tight);
		margin-bottom: var(--spacing-sm);
		transition: color var(--transition-fast);
	}

	.class-card:hover .class-title {
		color: var(--color-brand);
	}

	.class-summary {
		font-size: var(--font-size-base);
		color: var(--color-muted);
		line-height: var(--leading-normal);
		margin-bottom: var(--spacing-sm);
	}

	.class-location {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.empty-state {
		text-align: center;
		padding: var(--spacing-4xl) var(--spacing-lg);
		color: var(--color-muted);
	}

	.past-classes {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--spacing-lg) var(--spacing-4xl);
	}

	.past-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		margin-bottom: var(--spacing-lg);
		padding-top: var(--spacing-2xl);
		border-top: 1px solid var(--color-border);
	}

	.past-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
	}

	.past-list li {
		display: flex;
		align-items: baseline;
		gap: var(--spacing-md);
	}

	.past-list a {
		color: var(--color-muted);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.past-list a:hover {
		color: var(--color-text);
	}

	.past-date {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	@media (max-width: 768px) {
		.classes-list {
			grid-template-columns: 1fr;
		}
	}
</style>
