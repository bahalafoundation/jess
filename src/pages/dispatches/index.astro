---
export const prerender = false;

import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const { entries: dispatches, cacheHint } = await getEmDashCollection("dispatches", {
	orderBy: { published_on: "desc" },
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title="Dispatches" description="Members-only essays, recordings, and resources.">
	<header class="dispatches-header">
		<h1>Dispatches</h1>
		<p class="dispatches-intro">
			Longer, members-only writing. Full dispatches unlock the moment you pay
			for any class — see <a href="/classes">upcoming classes</a>. Already a
			member? <a href="/members/login">Log in</a>.
		</p>
	</header>

	{
		dispatches && dispatches.length > 0 ? (
			<section class="dispatches-grid">
				{dispatches.map((entry) => (
					<article class="dispatch-card">
						{entry.data.featured_image && (
							<div class="dispatch-card-image">
								<Image image={entry.data.featured_image} />
							</div>
						)}
						<h2 class="dispatch-card-title">
							<a href={`/dispatches/${entry.id}`}>{entry.data.title}</a>
						</h2>
						{entry.data.summary && (
							<p class="dispatch-card-summary">{entry.data.summary}</p>
						)}
					</article>
				))}
			</section>
		) : (
			<section class="empty-state">
				<p>No dispatches yet.</p>
			</section>
		)
	}
</Base>

<style>
	.dispatches-header {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-3xl) var(--spacing-lg) var(--spacing-2xl);
	}

	.dispatches-header h1 {
		font-size: var(--font-size-3xl);
		margin-bottom: var(--spacing-md);
	}

	.dispatches-intro {
		font-size: var(--font-size-lg);
		color: var(--color-muted);
		line-height: var(--leading-normal);
		max-width: 600px;
	}

	.dispatches-intro a {
		color: var(--color-text);
	}

	.dispatches-grid {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--spacing-lg) var(--spacing-4xl);
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: var(--spacing-2xl);
	}

	.dispatch-card-image img {
		width: 100%;
		height: auto;
		border-radius: var(--radius);
		margin-bottom: var(--spacing-md);
	}

	.dispatch-card-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		margin-bottom: var(--spacing-sm);
	}

	.dispatch-card-title a {
		color: var(--color-text);
		text-decoration: none;
	}

	.dispatch-card-title a:hover {
		color: var(--color-brand);
	}

	.dispatch-card-summary {
		color: var(--color-muted);
		font-size: var(--font-size-base);
		line-height: var(--leading-normal);
	}

	.empty-state {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--spacing-lg) var(--spacing-4xl);
		text-align: center;
		color: var(--color-muted);
	}

	@media (max-width: 768px) {
		.dispatches-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
