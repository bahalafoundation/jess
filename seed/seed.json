	"content": {
		"pages": [
			{
				"id": "about",
				"slug": "about",
				"status": "published",
				"data": {
					"title": "About",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "We are a small design studio focused on creating meaningful work for thoughtful clients. Founded in 2020, we've had the privilege of working with brands across technology, culture, and the arts.",
									"_key": "k1"
								}
							],
							"_key": "k0"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Our approach is simple: listen carefully, think deeply, and craft with intention. We believe that good design is invisible — it gets out of the way and lets the work speak for itself.",
									"_key": "k3"
								}
							],
							"_key": "k2"
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "What we do",
									"_key": "k5"
								}
							],
							"_key": "k4"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "We specialize in brand identity, web design, and art direction. Whether you need a complete visual identity or a single website, we bring the same level of care and attention to every project.",
									"_key": "k7"
								}
							],
							"_key": "k6"
						}
					]
				}
			}
		],
		"classes": [
			{
				"id": "film-photography-workshop",
				"slug": "film-photography-workshop",
				"status": "published",
				"data": {
					"title": "Shooting on Film",
					"summary": "A hands-on introduction to medium format film photography — metering, composition, and slowing down. Cameras provided.",
					"featured_image": {
						"$media": {
							"url": "https://images.unsplash.com/photo-1495121553079-4c61bcce1894?w=1200&h=900&fit=crop",
							"alt": "A medium format film camera on a wooden table",
							"filename": "photo-1495121553079-4c61bcce1894.jpg"
						}
					},
					"start_time": "2026-09-19T10:00:00-07:00",
					"end_time": "2026-09-19T14:00:00-07:00",
					"location": "Studio, San Francisco",
					"capacity": 8,
					"price": "$120",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Film forces patience. In this half-day workshop we cover loading and metering a medium format camera, reading light without a screen, and composing when every frame costs something. We end with a short walk to shoot a roll together.",
									"_key": "k1"
								}
							],
							"_key": "k0"
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [{ "_type": "span", "text": "What to bring", "_key": "k3" }],
							"_key": "k2"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Just yourself and comfortable shoes. Cameras, film, and development for one roll are included in the price. No prior experience needed.",
									"_key": "k5"
								}
							],
							"_key": "k4"
						}
					]
				}
			},
			{
				"id": "brand-identity-intensive",
				"slug": "brand-identity-intensive",
				"status": "published",
				"data": {
					"title": "Brand Identity Intensive",
					"summary": "One day, one brand: take a real brief from research to a presented identity concept. For designers who want a sharper process.",
					"featured_image": {
						"$media": {
							"url": "https://images.unsplash.com/photo-1561070791-2526d30994b5?w=1200&h=900&fit=crop",
							"alt": "Sketchbooks and printed logo explorations on a desk",
							"filename": "photo-1561070791-2526d30994b5.jpg"
						}
					},
					"start_time": "2026-10-10T09:30:00-07:00",
					"end_time": "2026-10-10T17:00:00-07:00",
					"location": "Studio, San Francisco",
					"capacity": 10,
					"price": "$250",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "We run the day the way we run a real project: a morning of research and positioning, an afternoon of wordmark and system sketches, and a final hour presenting to the group as if they were the client.",
									"_key": "k1"
								}
							],
							"_key": "k0"
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [{ "_type": "span", "text": "Who it's for", "_key": "k3" }],
							"_key": "k2"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Working designers and serious students. You should be comfortable in your design tool of choice — the day is about process and critique, not software.",
									"_key": "k5"
								}
							],
							"_key": "k4"
						}
					]
				}
			},
			{
				"id": "editorial-layout-evening",
				"slug": "editorial-layout-evening",
				"status": "published",
				"data": {
					"title": "Editorial Layout, An Evening",
					"summary": "Grids, type hierarchy, and pacing across spreads — the fundamentals of print layout in one focused evening session.",
					"featured_image": {
						"$media": {
							"url": "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=1200&h=900&fit=crop",
							"alt": "Open magazine spreads laid out on a table",
							"filename": "photo-1544716278-ca5e3f4abd8c.jpg"
						}
					},
					"start_time": "2026-11-05T18:30:00-08:00",
					"end_time": "2026-11-05T21:00:00-08:00",
					"location": "Studio, San Francisco",
					"capacity": 12,
					"price": "$60",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Using spreads from The Archive catalog as our case study, we look at how a grid gets built, how type hierarchy carries a reader through a page, and how pacing works across a sequence of spreads. Bring a magazine you love and we'll take a few apart together.",
									"_key": "k1"
								}
							],
							"_key": "k0"
						}
					]
				}
			}
		],
		"projects": [
			{
				"id": "meridian-brand",
				"slug": "meridian-brand",
				"status": "published",
				"data": {
					"title": "Meridian",
					"client": "Meridian Collective",
					"year": "2024",
					"summary": "A complete brand identity for a creative collective bringing together artists and technologists.",
					"featured_image": {
						"$media": {
							"url": "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=1200&h=900&fit=crop",
							"alt": "Meridian cover image",
							"filename": "photo-1558618666-fcd25c85cd64.jpg"
						}
					},
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Meridian Collective needed a visual identity that could bridge the gap between traditional art and emerging technology. The challenge was to create something that felt timeless yet forward-looking.",
									"_key": "k1"
								}
							],
							"_key": "k0"
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "The approach",
									"_key": "k3"
								}
							],
							"_key": "k2"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "We developed a wordmark that combines classical typography with subtle geometric forms. The color palette draws from both digital interfaces and natural materials, creating a bridge between worlds.",
									"_key": "k5"
								}
							],
							"_key": "k4"
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "The result",
									"_key": "k7"
								}
							],
							"_key": "k6"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "The new identity has been applied across print and digital touchpoints, from business cards to a fully responsive website. Meridian has received positive feedback from both artists and technologists alike.",
									"_key": "k9"
								}
							],
							"_key": "k8"
						}
					]
				},
				"taxonomies": {
					"category": ["branding"],
					"tag": ["identity", "art-direction"]
				}
			},
			{
				"id": "volta-web",
				"slug": "volta-web",
				"status": "published",
				"data": {
					"title": "Volta",
					"client": "Volta Energy",
					"year": "2024",
					"summary": "Website design for a renewable energy startup making clean power accessible to everyone.",
					"featured_image": {
						"$media": {
							"url": "https://images.unsplash.com/photo-1497366216548-37526070297c?w=1200&h=900&fit=crop",
							"alt": "Volta cover image",
							"filename": "photo-1497366216548-37526070297c.jpg"
						}
					},
					"url": "https://volta.example.com",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Volta is on a mission to make renewable energy accessible to everyone. They needed a website that could explain complex technology simply while inspiring trust in potential customers.",
									"_key": "k1"
								}
							],
							"_key": "k0"
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "Design principles",
									"_key": "k3"
								}
							],
							"_key": "k2"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "We focused on clarity and warmth. The design uses generous whitespace and a vibrant green accent that evokes growth and sustainability without feeling clichéd.",
									"_key": "k5"
								}
							],
							"_key": "k4"
						}
					]
				},
				"taxonomies": {
					"category": ["web"],
					"tag": ["ui-ux", "development"]
				}
			},
			{
				"id": "archive-print",
				"slug": "archive-print",
				"status": "published",
				"data": {
					"title": "The Archive",
					"client": "City Museum",
					"year": "2023",
					"summary": "Exhibition catalog and print materials for a retrospective on modernist architecture.",
					"featured_image": {
						"$media": {
							"url": "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=1200&h=900&fit=crop",
							"alt": "The Archive cover image",
							"filename": "photo-1507003211169-0a1dd7228f2d.jpg"
						}
					},
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "The Archive was a major exhibition at the City Museum, showcasing 50 years of modernist architecture through photographs, drawings, and models. We designed the complete print identity.",
									"_key": "k1"
								}
							],
							"_key": "k0"
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "The catalog",
									"_key": "k3"
								}
							],
							"_key": "k2"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "The 240-page catalog uses a strict grid system inspired by the work being exhibited. Full-bleed photography alternates with dense text spreads, creating a rhythm that echoes the exhibition layout.",
									"_key": "k5"
								}
							],
							"_key": "k4"
						}
					]
				},
				"taxonomies": {
					"category": ["print"],
					"tag": ["editorial", "art-direction"]
				}
			},
			{
				"id": "coastal-photo",
				"slug": "coastal-photo",
				"status": "published",
				"data": {
					"title": "Coastal",
					"client": "Personal Project",
					"year": "2023",
					"summary": "A photographic study of the Pacific coastline, exploring the intersection of land, sea, and sky.",
					"featured_image": {
						"$media": {
							"url": "https://images.unsplash.com/photo-1505142468610-359e7d316be0?w=1200&h=900&fit=crop",
							"alt": "Coastal cover image",
							"filename": "photo-1505142468610-359e7d316be0.jpg"
						}
					},
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Coastal began as a weekend project and grew into a year-long exploration of the Pacific shoreline. Shot entirely on medium format film, the series captures the quiet drama of the coast.",
									"_key": "k1"
								}
							],
							"_key": "k0"
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"text": "Process",
									"_key": "k3"
								}
							],
							"_key": "k2"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Each image was made at dawn or dusk, when the light is softest and the beaches are empty. The slow process of shooting film encourages patience and intentionality — qualities that show in the final work.",
									"_key": "k5"
								}
							],
							"_key": "k4"
						}
					]
				},
				"taxonomies": {
					"category": ["photography"],
					"tag": ["art-direction", "editorial"]
				}
			}
		]
	}
